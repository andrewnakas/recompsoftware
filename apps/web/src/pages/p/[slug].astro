---
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Cover from '../../components/Cover.astro';
import Spark from '../../components/Spark.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import ProgressChart from '../../components/ProgressChart.astro';
import {
  projects, statsFor, statsDate, lineage, history, news, formatDate, fmtNum, CATEGORIES, METHOD_LABEL,
  PROVENANCE_LABEL, TIER_LABEL, platformHref, hubFor, mediaFor, growth, growthLabel, progressFor, progressDelta, progressDate,
  PROGRESS_SOURCE_LABEL, type Project,
} from '../../lib/data';

export function getStaticPaths() {
  return projects().map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const s = statsFor(p);
const cat = CATEGORIES.find((c) => c.id === p.category)!;
const platHref = platformHref(p.originalPlatform);
const all = projects();
const find = (slug: string) => all.find((x) => x.slug === slug);
const edges = lineage();
const parents = edges.filter((e) => e.slug === p.slug).flatMap((e) => e.parents.map((x) => ({ rel: e.relation, p: find(x) }))).filter((x) => x.p);
const children = edges.filter((e) => e.parents.includes(p.slug)).map((e) => ({ rel: e.relation, p: find(e.slug) })).filter((x) => x.p);
const events = history().flatMap((era) => era.events).filter((e) => e.projects?.includes(p.slug));
const items = news().filter((n) => n.projects?.includes(p.slug)).slice(0, 8);
const hub = hubFor(p);
const sameGame = hub ? hub.list.filter((x) => x.slug !== p.slug) : [];
const related = [...sameGame, ...all.filter((x) => x.slug !== p.slug && !sameGame.includes(x) && x.category === p.category && (x.originalPlatform === p.originalPlatform || x.tags.some((t) => p.tags.includes(t))))].slice(0, 6);
const release = s?.release ?? p.latestRelease;
const media = mediaFor(p);
const g = growth(p);
const pr = progressFor(p);
const d30 = pr ? progressDelta(p, 30) : null;
// Search visitors mostly want the build: link the latest GitHub release directly.
const gh = p.repo && /github\.com\//.test(p.repo) ? p.repo.replace(/\/$/, '').replace(/\.git$/, '') : null;
const dl = release && gh ? `${gh}/releases/latest` : null;
// "3 days ago" next to the button shows the project is alive; null when the release has no date
const ago = (iso?: string) => {
  if (!iso) return null;
  const days = Math.floor((Date.parse(statsDate() ?? iso) - Date.parse(iso)) / 864e5);
  return days < 1 ? 'today' : days < 2 ? 'yesterday' : days < 60 ? `${days} days ago` : days < 730 ? `${Math.round(days / 30)} months ago` : `${Math.round(days / 365)} years ago`;
};
const releasedAgo = ago(release?.date);
// Project-page visitors read ~1.2 pages: offer the next click above the fold, not only at the bottom.
const more = related.slice(0, 3);
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const verb = p.method === 'static-recomp' ? 'recompiled' : p.method.includes('decomp') ? 'decompiled' : p.method === 'clean-room' ? 'rebuilt clean-room' : 'rebuilt';
// Searchers type "<game> recomp", "<game> pc", "<game> github": put the game, the method and what's here in the title.
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const kind = p.method.includes('decomp') ? 'decompilation' : p.method === 'clean-room' ? 'clean-room rebuild'
  : p.method === 'static-recomp' ? 'PC recomp' : p.category === 'apps' || p.category === 'os' || p.category === 'tools' ? 'source port' : 'PC port';
// skip what the name already says, and the game when the title would run long
const saysKind = /decomp|disasm|disassembl|recomp|port|reimpl|rebuild|remake/.test(norm(p.name));
const sub = p.subject && !norm(p.name).includes(norm(p.subject).slice(0, 8)) && (p.name + p.subject).length <= 44 ? p.subject : '';
const wants = p.playable ? 'play in browser' : dl ? 'download & source' : 'source & status';
// forks and rival repos share a name: the owner keeps their titles apart, or Google folds them into one page
const owner = gh?.split('/')[3];
const twin = owner && projects().some((o) => o.slug !== p.slug && norm(o.name) === norm(p.name));
const name = twin ? `${p.name} by ${owner}` : p.name;
const title = sub ? `${name}: ${sub} ${kind}, ${wants}` : saysKind ? `${name}: ${wants}` : `${name}: ${kind}, ${wants}`;
const description = `${p.name}: ${p.summary} Status, ${PROVENANCE_LABEL[p.provenance].toLowerCase()} provenance, licence, latest release and live GitHub activity.`.slice(0, 300);
const schema = {
  '@type': 'SoftwareSourceCode', name: p.name, description: p.summary, codeRepository: p.repo ?? undefined,
  license: p.licence, programmingLanguage: undefined, url: `https://recompsoftware.com/p/${p.slug}/`,
  author: p.team.map((t) => ({ '@type': 'Person', name: t })),
};
---
<Base title={title} description={description} type="article" schema={schema} image={`/og/p-${p.slug}.jpg`}>
  <article class="wrap proj">
    <div class="top">
      <div class="intro">
        <p class="crumbs"><a href="/">Recomp</a> / <a href={`/${p.category}/`}>{cat.label}</a> / {platHref ? <a href={platHref}>{p.originalPlatform}</a> : p.originalPlatform}</p>
        <h1>{p.name}</h1>
        <p class="lede">{p.summary}</p>
        <Badges p={p} full />
        {hub && <p class="hub-link"><a href={`/game/${hub.slug}/`}>All {hub.list.length} {hub.name} projects compared →</a></p>}

        <div class="cta btns">
          {p.playable && (p.playable.launch === 'tab'
            ? <a class="btn primary" href={p.playable.url} target="_blank" rel="noopener" data-track="play_click" data-item={p.slug}>▶ Play in browser</a>
            : <a class="btn primary" href={`/play/${p.slug}/`} data-track="play_click" data-item={p.slug}>▶ Play in browser</a>)}
          {dl && <a class={`btn${p.playable ? '' : ' primary'}`} href={dl} rel="noopener" data-track="download_click" data-item={p.slug}>⬇ Download {release!.version}</a>}
          {p.repo && <a class="btn" href={p.repo} rel="noopener" data-track="repo_click" data-item={p.slug}>Source code</a>}
          {p.website && <a class="btn" href={p.website} rel="noopener">Website</a>}
          {p.discord && <a class="btn" href={p.discord} rel="noopener">Discord</a>}
          {p.subreddit && <a class="btn" href={p.subreddit} rel="noopener">Reddit</a>}
        </div>
        {(releasedAgo || gh) && (
          <p class="meta cta-meta">
            {releasedAgo && <>{release!.version} released {releasedAgo}. </>}
            {gh && <a href={`${gh}/releases.atom`} rel="noopener" data-track="watch_click" data-item={p.slug}>Get new releases by RSS</a>}
          </p>
        )}
        {more.length > 0 && (
          <p class="more"><span class="meta">More like this:</span> {more.map((r, i) => <>{i > 0 && ' · '}<a href={`/p/${r.slug}/`} data-track="related_click" data-item={r.slug}>{r.name}</a></>)}</p>
        )}
      </div>
      <figure class="shot">
        <Cover p={p} eager large />
        {media?.thumb && <figcaption class="meta">Image: the project's own {media.kind === 'social' ? 'GitHub preview' : 'README'}{p.repo && <> · <a href={p.repo} rel="noopener">source</a></>}</figcaption>}
      </figure>
    </div>

    <section class="stats" aria-label="Activity">
      <div><span class="k">Stars</span><span class="v">{s ? fmtNum(s.stars) : '—'}</span>{g && <span class="d">{growthLabel(g)}</span>}<Spark p={p} /></div>
      <div><span class="k">Commits, 30 days</span><span class="v">{s?.commits30 ?? '—'}</span></div>
      <div><span class="k">Latest release</span><span class="v">{release ? release.version : '—'}</span>{release?.date && <span class="d">{formatDate(release.date.slice(0, 10))}</span>}</div>
      <div><span class="k">Last push</span><span class="v">{s?.pushedAt ? formatDate(s.pushedAt.slice(0, 10)) : '—'}</span>{s?.archived && <span class="d">archived</span>}</div>
      {pr && <div><span class="k">Matched</span><span class="v">{pr.pct}%</span>{d30 ? <span class="d">+{d30} pts in 30 days</span> : pr.sourceUrl && <a class="d" href={pr.sourceUrl} rel="noopener">{host(pr.sourceUrl)}</a>}</div>}
    </section>
    {s && <p class="meta">GitHub figures as of {statsDate()}, refreshed daily.</p>}

    {pr && (
      <section class="progress" aria-label="Decomp progress">
        <h2>Decomp progress</h2>
        <ProgressBar p={p} source />
        <ProgressChart p={p} />
        <p class="meta">
          {pr.linkedPct != null && <>Linked (fully built from source): {pr.linkedPct}%. </>}
          {pr.source === 'manual' ? "Figure entered by hand from the project's own page" : `Figure from ${PROGRESS_SOURCE_LABEL[pr.source]}`}{pr.at && `, measured ${formatDate(pr.at)}`}, checked {progressDate() ?? pr.at}.
          {pr.ranked ? ' This project opted into public progress tracking.' : ' Shown, never ranked: only projects that opted into a public tracker go on the boards.'} <a href="/progress/#how">How this works</a>
        </p>
      </section>
    )}

    <div class="cols">
      <section class="facts">
        <h2>Facts</h2>
        <dl>
          <dt>Original</dt><dd>{p.subject}{p.originalYear && ` (${p.originalYear})`}</dd>
          <dt>Platform</dt><dd>{platHref ? <a href={platHref}>{p.originalPlatform}</a> : p.originalPlatform}</dd>
          <dt>Method</dt><dd>{METHOD_LABEL[p.method]}</dd>
          <dt>Provenance</dt><dd>{PROVENANCE_LABEL[p.provenance]}{p.provenanceNote && <span class="note"> · {p.provenanceNote}</span>} <a class="note" href="/about/#labels">what this means</a></dd>
          <dt>Status</dt><dd>{p.status}{pr && ` · ${pr.pct}% matched`}</dd>
          <dt>Licence</dt><dd>{p.licence}</dd>
          {p.team.length > 0 && <><dt>Team</dt><dd>{p.team.join(', ')}</dd></>}
          {p.started && <><dt>Started</dt><dd>{p.started}</dd></>}
          {p.firstRelease && <><dt>First release</dt><dd>{p.firstRelease}</dd></>}
          {p.targets.length > 0 && <><dt>Runs on</dt><dd>{p.targets.join(', ')}</dd></>}
          <dt>Needs the original</dt><dd>{p.needsOriginal ? 'Yes: you supply your own legally obtained copy' : 'No'}</dd>
        </dl>
      </section>
      <section>
        <h2>How to get it legally</h2>
        {p.playable ? (
          <p><strong>{TIER_LABEL[p.playable.tier]}.</strong> {p.playable.note}</p>
        ) : p.needsOriginal ? (
          <p>This project ships code only. Build or download it from the official repository, then supply data from a copy of <em>{p.subject}</em> you own. Recomp never links to ROMs, discs or game data.</p>
        ) : (
          <p>Download it from the official repository{p.website ? ' or website' : ''}. No original files are needed.</p>
        )}
        <p>This project was {verb}{p.team.length > 0 && <> by {p.team.slice(0, 3).join(', ')}{p.team.length > 3 && ' and others'}</>}. Facts last checked {p.checked}. <a class="note" href={`https://github.com/andrewnakas/recompsoftware/issues/new?template=correction.yml&title=${encodeURIComponent(`[fix] ${p.name}`)}&page=${encodeURIComponent(`https://recompsoftware.com/p/${p.slug}/`)}`} rel="noopener" data-track="correction_click" data-item={p.slug}>Suggest a correction</a></p>
      </section>
    </div>

    {(parents.length > 0 || children.length > 0) && (
      <section>
        <h2>Lineage</h2>
        <ul class="lin">
          {parents.map((x) => <li><span class="meta">{x.rel.replace(/-/g, ' ')}</span> <a href={`/p/${x.p!.slug}/`}>{x.p!.name}</a></li>)}
          {children.map((x) => <li><a href={`/p/${x.p!.slug}/`}>{x.p!.name}</a> <span class="meta">{x.rel.replace(/-/g, ' ')} this</span></li>)}
        </ul>
      </section>
    )}

    {(events.length > 0 || items.length > 0) && (
      <section>
        <h2>Timeline</h2>
        <ol class="tl">
          {[...events.map((e) => ({ date: e.date, title: e.title, source: e.source })), ...items.map((n) => ({ date: n.date, title: n.title, source: n.source }))]
            .sort((a, b) => b.date.localeCompare(a.date))
            .map((e) => <li><time class="meta">{formatDate(e.date)}</time> <a href={e.source} rel="noopener">{e.title}</a></li>)}
        </ol>
      </section>
    )}

    <section>
      <h2>Sources</h2>
      <ul class="src">{p.sources.map((u) => <li><a href={u} rel="noopener">{u}</a></li>)}</ul>
      <p class="meta">Something wrong or out of date? <a href={`https://github.com/andrewnakas/recompsoftware/issues/new?template=correction.yml&title=${encodeURIComponent("Correction: " + p.name)}&page=${encodeURIComponent(`https://recompsoftware.com/p/${p.slug}/`)}`}>Send a correction</a>.</p>
    </section>

    {related.length > 0 && (
      <section>
        <div class="rule-head"><h2>Related</h2><a href={`/${p.category}/`}>All {cat.label.toLowerCase()} →</a></div>
        <div class="grid">{related.map((r) => <ProjectCard p={r} />)}</div>
      </section>
    )}
  </article>
</Base>
<style>
  .progress { margin-top: 1.6rem; max-width: 760px; }
  .progress :global(.pbar) { font-size: 0.9rem; }
  .progress :global(.pbar .track) { height: 9px; }
  .top { display: grid; gap: 1.2rem 2.5rem; align-items: start; }
  @media (min-width: 900px) { .top { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } .shot { margin-top: 2rem; } }
  .intro > :global(h1) { margin-top: 0.3rem; }
  .shot { margin: 0; }
  .shot figcaption { margin-top: 0.4rem; }
  .shot :global(.cover) { box-shadow: 0 18px 50px -20px rgb(0 0 0 / 0.6); }
  .hub-link { margin: 0.8rem 0 0; font-weight: 600; }
  .proj { padding-top: 2rem; }
  .proj h1 { margin-bottom: 0.6rem; }
  .cta { margin: 1.4rem 0 0.5rem; }
  .cta-meta { margin: 0 0 0.8rem; }
  .more { margin: 0; font-size: 0.92rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); margin-top: 1.5rem; }
  .stats div { padding: 0.8rem 0.8rem 0.8rem 0; display: grid; gap: 0.1rem; }
  .k { font: 500 0.72rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); }
  .v { font: 700 1.5rem/1.2 var(--font-display); }
  .d { font: 0.78rem var(--font-mono); color: var(--accent); }
  .cols { display: grid; gap: 0 3rem; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1.2rem; margin: 0; }
  dt { font: 500 0.8rem/1.6 var(--font-mono); color: var(--ink-faint); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  @media (max-width: 520px) { dl { grid-template-columns: 1fr; gap: 0 0; } dd { margin-bottom: 0.6rem; } }
  .note { color: var(--ink-faint); font-size: 0.88rem; }
  .lin, .tl, .src { padding-left: 1.1rem; }
  .src { overflow-wrap: anywhere; font-size: 0.9rem; }
</style>
