---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { news, projects, formatDate } from '../../lib/data';
const items = news();
const all = projects();
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---
<Base title="Decomp & recomp news" description="Releases, milestones and announcements from decompilation, recompilation and preservation projects, each linked to its source.">
  <PageHead kicker="News" title="News" lede="Releases, milestones and announcements from across the scene, checked and linked to where they were announced." />
  <section class="wrap">
    {items.length === 0 && <p>The first stories are on their way. Meanwhile see <a href="/history/">the history</a>.</p>}
    <ol class="news">
      {items.map((n) => (
        <li>
          <time class="meta">{formatDate(n.date)}</time>
          <h3><a href={n.source} rel="noopener">{n.title}</a></h3>
          <p>{n.body}</p>
          <p class="meta">{n.projects?.map((s) => all.find((p) => p.slug === s)).filter(Boolean).map((p) => <a href={`/p/${p!.slug}/`}>{p!.name}</a>)} <span>via {host(n.source)}</span></p>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .news { list-style: none; padding: 0; max-width: 75ch; }
  .news li { border-top: 1px solid var(--line); padding: 1rem 0; }
  .news h3 { margin: 0.2rem 0 0.3rem; }
  .news p { margin: 0; color: var(--ink-soft); }
  .news .meta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 0.4rem; }
</style>
