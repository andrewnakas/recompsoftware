---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Catalog from '../components/Catalog.astro';
import { CATEGORIES, projects, gameHubs, type Category } from '../lib/data';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { cat: c.id } }));
}
const id = Astro.params.cat as Category;
const c = CATEGORIES.find((x) => x.id === id)!;
const list = projects().filter((p) => p.category === id);
const titles: Record<Category, string> = {
  games: 'Decompiled & recompiled games',
  apps: 'Rebuilt apps & creative tools',
  os: 'Operating systems & system software, reimplemented',
  tools: 'Reverse engineering tools',
  preservation: 'Preservation & revival projects',
};
---
<Base title={titles[id]} description={`${c.blurb} ${list.length} projects tracked, with live GitHub activity and provenance labels.`}>
  <PageHead kicker={c.label} title={titles[id]} lede={c.blurb}>
    {id === 'games' && <p class="meta">Popular: {gameHubs().slice(0, 8).map((h, i) => <>{i > 0 && ' · '}<a href={`/game/${h.slug}/`}>{h.name}</a></>)} · <a href="/game/">all {gameHubs().length} games compared →</a></p>}
  </PageHead>
  <section class="wrap"><Catalog list={list} /></section>
</Base>
