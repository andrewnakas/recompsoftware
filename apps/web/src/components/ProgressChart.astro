---
// Matched % over time as a step line (the value holds until the next change), 0-100 scale.
import { progressSeries, progressFor, progressDate, formatDate, type Project } from '../lib/data';
interface Props { p: Project; w?: number; h?: number }
const { p, w = 640, h = 180 } = Astro.props;
const s = progressSeries(p);
const pr = progressFor(p);
const L = 34, R = 8, T = 8, B = 22;
const t0 = s.length ? Date.parse(s[0][0]) : 0;
const t1 = Math.max(Date.parse(progressDate() ?? s[s.length - 1]?.[0] ?? '2000-01-01'), s.length ? Date.parse(s[s.length - 1][0]) : 0);
const x = (d: string | number) => L + ((typeof d === 'number' ? d : Date.parse(d)) - t0) / Math.max(1, t1 - t0) * (w - L - R);
const y = (v: number) => T + (1 - v / 100) * (h - T - B);
let d = '';
s.forEach(([date, v], i) => { d += i ? ` H${x(date).toFixed(1)} V${y(v).toFixed(1)}` : `M${x(date).toFixed(1)} ${y(v).toFixed(1)}`; });
if (s.length) d += ` H${x(t1).toFixed(1)}`;
const first = s[0], last = s[s.length - 1];
---
{s.length >= 2 && pr && (
  <figure class="pchart">
    <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={`Matched code from ${first[1]}% on ${first[0]} to ${last[1]}% on ${last[0]}`}>
      {[0, 25, 50, 75, 100].map((v) => (<>
        <line x1={L} x2={w - R} y1={y(v)} y2={y(v)} class={v % 50 ? 'grid' : 'grid strong'} />
        <text x={L - 6} y={y(v) + 3.5} class="ax" text-anchor="end">{v}%</text>
      </>))}
      <path d={`${d} V${y(0)} H${L} Z`} class="area" />
      <path d={d} class="line" />
      <circle cx={x(t1)} cy={y(last[1])} r="3" class="dot" />
      <text x={L} y={h - 6} class="ax">{formatDate(first[0])}</text>
      <text x={w - R} y={h - 6} class="ax" text-anchor="end">{formatDate(new Date(t1).toISOString().slice(0, 10))}</text>
    </svg>
    <figcaption class="meta">Matched code over time, {s.length} recorded changes{pr.version && <>, version {pr.version}</>}.</figcaption>
  </figure>
)}
<style>
  .pchart { margin: 0.5rem 0 0; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .grid.strong { stroke: var(--line-strong); }
  .ax { fill: var(--ink-faint); font: 10px var(--font-mono); }
  .line { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
  .area { fill: var(--accent); opacity: 0.1; }
  .dot { fill: var(--accent); }
</style>
