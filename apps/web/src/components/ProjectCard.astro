---
import Badges from './Badges.astro';
import Cover from './Cover.astro';
import { statsFor, fmtNum, growth, growthLabel, type Project } from '../lib/data';
interface Props { p: Project; note?: string; eager?: boolean }
const { p, note, eager } = Astro.props;
const s = statsFor(p);
const g = growth(p);
---
<a class="card pc" href={`/p/${p.slug}/`}
   data-cat={p.category} data-method={p.method} data-prov={p.provenance} data-platform={p.originalPlatform}
   data-play={p.playable ? '1' : '0'} data-stars={s?.stars ?? 0} data-name={p.name.toLowerCase()}
   data-q={`${p.name} ${p.subject} ${p.originalPlatform} ${p.tags.join(' ')} ${p.team.join(' ')}`.toLowerCase()}>
  <span class="art">
    <Cover p={p} eager={eager} />
    {g && g.delta > 0 && <span class="pill up">{growthLabel(g)}</span>}
    {p.playable && <span class="pill play">▶ Playable</span>}
  </span>
  <p class="meta">{p.originalPlatform}{p.originalYear && ` · ${p.originalYear}`}{s && <> · ★ {fmtNum(s.stars)}</>}</p>
  <h3>{p.name}</h3>
  {p.subject && p.subject !== p.name && <p class="subj">{p.subject}</p>}
  <p class="sum">{note ?? p.summary}</p>
  <div class="b"><Badges p={p} /></div>
</a>
<style>
  .art { position: relative; display: block; margin-bottom: 0.7rem; }
  .art :global(.cover) { transition: transform 0.25s ease, border-color 0.2s; }
  .pc:hover .art :global(.cover) { border-color: var(--accent); }
  .pill { position: absolute; top: 0.5rem; font: 500 0.7rem/1 var(--font-mono); padding: 0.3rem 0.45rem; border-radius: 4px; backdrop-filter: blur(6px); }
  .up { left: 0.5rem; background: rgb(13 16 15 / 0.78); color: #3ee0a8; }
  .play { right: 0.5rem; background: #3ee0a8; color: #0d100f; }
  .subj { font-size: 0.85rem !important; color: var(--ink-faint) !important; margin-bottom: 0.3rem !important; }
  .sum { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .b { margin-top: 0.6rem; }
</style>
