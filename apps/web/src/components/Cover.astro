---
// A project's picture: its own thumbnail when it has one, else a generated tile in its platform's colour.
import { mediaFor, platformHue, shortName, type Project } from '../lib/data';
interface Props { p: Project; eager?: boolean; large?: boolean }
const { p, eager = false, large = false } = Astro.props;
const m = mediaFor(p);
// Tools are known by name; everything else by the platform it came from.
const label = p.category === 'tools' ? p.name : shortName(p.originalPlatform || 'Multi');
const small = label.length > 12;
---
{m?.thumb ? (
  <img class:list={['cover', { large }]} src={m.thumb} alt="" width="640" height="320" loading={eager ? 'eager' : 'lazy'} decoding="async" />
) : (
  <span class:list={['cover', 'gen', { large }]} style={`--h:${platformHue(p.originalPlatform || p.category)}`} aria-hidden="true">
    <span class:list={['gp', { small }]}>{label}</span>
    <span class="gs">{p.category === 'tools' ? p.subject : p.subject || p.name}</span>
  </span>
)}
<style>
  .cover { display: block; width: 100%; aspect-ratio: 2 / 1; object-fit: cover; border-radius: 6px; background: var(--bg-sunk); border: 1px solid var(--line); }
  .gen {
    position: relative; overflow: hidden; display: grid; align-content: end; padding: 0.8rem 0.9rem; gap: 0.1rem;
    background:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.16) 0 1px, transparent 1px 3px),
      radial-gradient(120% 90% at 85% 10%, hsl(var(--h) 70% 45% / 0.55), transparent 60%),
      linear-gradient(135deg, hsl(var(--h) 45% 16%), hsl(calc(var(--h) + 40) 40% 9%));
    color: #f2f6f3;
  }
  .gp { font: 700 clamp(1.6rem, 4vw, 2.3rem)/1 var(--font-display); letter-spacing: -0.03em; opacity: 0.95; }
  .gs { font: 400 0.72rem/1.3 var(--font-mono); opacity: 0.7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gp.small { font-size: clamp(1.1rem, 2.6vw, 1.5rem); }
  .large.gen .gp { font-size: clamp(2.4rem, 7vw, 4rem); }
  .large.gen { padding: 1.2rem 1.4rem; }
</style>
